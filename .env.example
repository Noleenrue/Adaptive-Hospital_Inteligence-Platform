# Local PostgreSQL connection used by the FastAPI service.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adaptive_hospital_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-postgres-password

# Dashboard API URL. The corrected-v3 local API uses port 8001 by default.
API_URL=http://127.0.0.1:8001

# Optional model-bundle directory. Leave blank to use the repository's
# models\ directory. A bundle must contain the pipeline, calibrator, and
# manifest together.
READMISSION_MODEL_DIR=